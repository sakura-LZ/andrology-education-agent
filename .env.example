# 复制为 .env 并填入真实值（.env 已被 .gitignore 保护，勿提交/勿公开）
DEEPSEEK_API_KEY=sk-你的key
# OpenAI 兼容接口地址；Hubcore 使用 /v1
DEEPSEEK_BASE_URL=https://api.hubcore.cn/v1
DEEPSEEK_MODEL=gpt-6.2-sol
PORT=3360
# 应用发送给模型的历史预算（字符数不等于token，也不是模型最大窗口）
CHAT_HISTORY_MESSAGES=80
CHAT_HISTORY_CHARS=64000
# HOST 默认 127.0.0.1（仅本机，由 Nginx 反代）；如需局域网直连改 0.0.0.0
HOST=127.0.0.1
# 访问口令（公网必配）：学生打开页面时输入，防陌生人调用烧 key
ACCESS_TOKEN=改成一个你记得住的口令
# 部署在 Nginx 反代之后置 1，让限流按真实客户端 IP 计算
TRUST_PROXY=1
# 每 IP 每分钟 /api 请求上限
RATE_LIMIT=30
# 教师端口令（与学生口令分开）：教师打开"教师端"面板时输入，看学习数据
TEACHER_TOKEN=改成一个只有你知道的口令
